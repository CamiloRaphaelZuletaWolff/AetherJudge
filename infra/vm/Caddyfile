# Caddy: public TLS in front of the executor's gRPC port.
#
# EXECUTOR_DOMAIN is <public-ip-with-dashes>.sslip.io (e.g. 203-0-113-7.sslip.io):
# sslip.io answers DNS for that name with the embedded IP, so we get a real
# hostname — and therefore a real Let's Encrypt certificate — without buying
# a domain. Caddy obtains/renews it automatically (HTTP-01 on port 80, or
# TLS-ALPN-01 on 443), so both ports must be open to the internet.

# Let's Encrypt works without an e-mail address. To receive expiry notices,
# add a global options block at the very top of this file:
#   {
#   	email you@your-real-domain.com
#   }

{$EXECUTOR_DOMAIN} {
	# Only the two gRPC services the gateway uses are proxied; everything
	# else (scanners, browsers) gets a bare 404 and never reaches the
	# executor. Authentication itself is enforced by the executor
	# (EXECUTOR_AUTH_TOKEN); Caddy only adds TLS.
	@grpc path /executor.v1.ExecutorService/* /grpc.health.v1.Health/*
	handle @grpc {
		# Largest legitimate Execute call is ~2.3 MB (code + stdin +
		# expected output); the executor itself caps messages at 3 MiB.
		request_body {
			max_size 4MB
		}
		# h2c = cleartext HTTP/2 to the executor on the private compose
		# network. gRPC requires HTTP/2 end to end.
		reverse_proxy h2c://executor:9090
	}
	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
