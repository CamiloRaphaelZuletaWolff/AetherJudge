# Copy to infra/vm/.env on the VM and fill in:   cp .env.example .env && nano .env
# (.env is git-ignored. Never commit the real token.)

# Public hostname Caddy gets a Let's Encrypt certificate for: the VM's public
# IPv4 with dots replaced by dashes, plus .sslip.io.
#   IP 203.0.113.7  ->  203-0-113-7.sslip.io
# The gateway (Render) then uses EXECUTOR_ADDR=<this>:443 and EXECUTOR_TLS=true.
EXECUTOR_DOMAIN=203-0-113-7.sslip.io

# Shared secret; must be byte-for-byte identical to EXECUTOR_AUTH_TOKEN on
# Render. >= 32 chars, no spaces. Generate one with:  openssl rand -base64 32
EXECUTOR_AUTH_TOKEN=

# Sandboxes judged at the same time. Keep Render's JUDGE_WORKERS equal to it.
#   Oracle A1 Flex 2 OCPU / 12 GB  -> 2      4 OCPU / 24 GB -> 4
#   Google e2-micro (1 GB + swap)  -> 1
EXECUTOR_MAX_CONCURRENT=2

# Compile budget per submission (ms). 20000 is fine on A1; use 30000 on an
# e2-micro. Keep it under ~40000 (the gateway's deadline is limit + 45 s).
EXECUTOR_COMPILE_TIMEOUT_MS=20000

# Images published by .github/workflows/executor-images.yml. The owner part
# of a GHCR path must be lowercase. Pin IMAGE_TAG to a short commit SHA
# (e.g. 3f2a1bc) instead of "latest" for reproducible rollbacks.
GHCR_OWNER=camiloraphaelzuletawolff
IMAGE_TAG=latest

# Only for PRIVATE GHCR packages: a GitHub username + a classic personal
# access token with the read:packages scope. Leave empty if the packages are
# public (recommended for a public portfolio repo).
GHCR_USER=
GHCR_TOKEN=

# Filled in automatically by deploy.sh (numeric GID of the host docker group).
# DOCKER_GID=
